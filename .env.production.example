# ============================================================================
# ENV PRODUCTION cho Docker Compose — copy file này thành `.env` (cùng thư mục
# be-vsoftware/) TRÊN SERVER rồi điền giá trị thật. Chạy: docker compose up -d --build
# Domain: phanmemzalo.com (web) · api.phanmemzalo.com (API)
# ============================================================================

# ===== Database =====
DB_USERNAME=postgres
DB_PASSWORD=ĐỔI_MẬT_KHẨU_DB_MẠNH
DB_DATABASE=news_db
# Cổng Postgres bind 127.0.0.1 trên host (chỉ để truy cập nội bộ/backup)
DB_PORT_HOST=5433

# ===== Auth — BẮT BUỘC đổi, mỗi cái 1 chuỗi ngẫu nhiên >= 32 ký tự =====
# Tạo nhanh:  openssl rand -hex 32
JWT_SECRET=ĐỔI_CHUỖI_NGẪU_NHIÊN_DÀI
JWT_REFRESH_SECRET=ĐỔI_CHUỖI_NGẪU_NHIÊN_KHÁC
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ===== Domain / URL =====
PUBLIC_URL=https://api.phanmemzalo.com
CORS_ORIGINS=https://phanmemzalo.com,https://www.phanmemzalo.com
BE_PORT=3001
FE_PORT=3000

# ===== FE build args (NEXT_PUBLIC_* — nướng vào lúc BUILD, không phải runtime) =====
NEXT_PUBLIC_API_URL=https://api.phanmemzalo.com
NEXT_PUBLIC_SITE_URL=https://phanmemzalo.com
NEXT_PUBLIC_SITE_NAME=MKT Software

# ===== Email (SMTP) — đang dùng mail của mktsoftware.vn =====
EMAIL_ENABLED=true
SMTP_HOST=mail.mktsoftware.vn
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@mktsoftware.vn
SMTP_PASSWORD=ĐỔI_MẬT_KHẨU_SMTP
SMTP_FROM_ADDRESS=info@mktsoftware.vn
SMTP_FROM_NAME=MKT Software
# Email nhận thông báo lead (ngoài Telegram). Đổi theo ý bạn.
CONTACT_RECEIVE_EMAIL=tuanpn@mktsoftware.vn

# ===== Misc =====
MAX_FILE_SIZE=5242880
# FORCE_RESEED=1 chỉ khi muốn restore lại data từ snapshot.json (CẨN THẬN: ghi đè DB)
FORCE_RESEED=0
